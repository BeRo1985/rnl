procedure TRNLQueue<T>.Clear;
begin
 fSpinLock.Acquire;
 try
  while fCount>0 do begin
   dec(fCount);
   Finalize(fItems[fHead]);
   inc(fHead);
   if fHead>=fSize then begin
    fHead:=0;
   end;
  end;
  fItems:=nil;
  fHead:=0;
  fTail:=0;
  fCount:=0;
  fSize:=0;
 finally
  fSpinLock.Release;
 end;
end;

