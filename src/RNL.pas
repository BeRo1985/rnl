       // choice of algorithm, changes.
       procedure DeriveKey;
       function HasRealm:boolean;
     end;

     PRNLSTUNResult=^TRNLSTUNResult;
     TRNLSTUNResult=record
      Success:boolean;
      MappedAddress:TRNLAddress;
      RoundTripTime:TRNLInt64;
