 end;

end;


class function TRNLBLAKE2BContext.RotateRight64(const aValue:TRNLUInt64;const aBits:TRNLUInt32):TRNLUInt64;
begin
{$ifdef fpc}
 result:=RORQWord(aValue,aBits);
{$else}
 result:=(aValue shl (64-aBits)) or (aValue shr aBits);
{$endif}
end;

