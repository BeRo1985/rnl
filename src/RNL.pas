  BitCount:=0;
  repeat
   FinalBlock:=GetBit<>0;
   BlockType:=ReadBits(2,0);
   case BlockType of
    0:begin
     result:=InflateUncompressedBlock;
    end;
    1:begin
     result:=InflateFixedBlock;
    end;
    2:begin
     result:=InflateDynamicBlock;
    end;
    else begin
     result:=false;
    end;
   end;
  until FinalBlock or not result;
