       RNL_X509_VERDICT_NOT_A_CERTIFICATE_AUTHORITY,
       RNL_X509_VERDICT_PATH_TOO_LONG,
       RNL_X509_VERDICT_MISSING_KEY_CERT_SIGN,
       RNL_X509_VERDICT_EXPIRED,
       RNL_X509_VERDICT_NOT_YET_VALID,
