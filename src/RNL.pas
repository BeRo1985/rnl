 FD_ZERO(result);
{$ifend}
end;

procedure TRNLSocketSetHelper.Clear;
begin
{$if defined(Posix)}
 __FD_ZERO(self);
{$elseif defined(Unix)}
 fpFD_ZERO(self);
{$else}
 FD_ZERO(self);
{$ifend}
