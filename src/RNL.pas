{$elseif defined(Unix)}
 fpFD_SET(aSocket,self);
{$else}
 FD_SET(aSocket,self);
{$ifend}
end;

procedure TRNLSocketSetHelper.Remove(const aSocket:TRNLSocket);
begin
{$if defined(Posix)}
 __FD_CLR(aSocket,self);
{$elseif defined(Unix)}
 fpFD_CLR(aSocket,self);
{$else}
 FD_CLR(aSocket,self);
{$ifend}
end;

function TRNLSocketSetHelper.Check(const aSocket:TRNLSocket):boolean;
