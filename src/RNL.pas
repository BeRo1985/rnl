             TAG_CONTEXT_0=TRNLUInt8($a0);
             TAG_CONTEXT_1=TRNLUInt8($a1);
             TAG_CONTEXT_2=TRNLUInt8($a2);
             TAG_CONTEXT_3=TRNLUInt8($a3);
